# ============================================================
# AUTOPILOT CREDENTIALS CONFIGURATION
# ============================================================

# 1. AI SCRIPT & SEO ENGINE (Optional - Built-in templates work without key)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. 4K VERTICAL B-ROLL (Optional - Procedural canvases work without key)
PEXELS_API_KEY=your_pexels_api_key_here

# 3. YOUTUBE UPLOADER
# Place client_secret.json in this directory and run: python youtube_uploader.py
# Once authorized, token.json will be created automatically.

# 4. INSTAGRAM REELS UPLOADER (Choose Option A or Option B)
# Option A: Direct Username/Password Login
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# Option B: Official Meta Graph API (For Creator / Business Accounts)
INSTAGRAM_ACCESS_TOKEN=your_meta_access_token_here
INSTAGRAM_USER_ID=your_instagram_account_id_here
